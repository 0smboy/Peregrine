[DEFAULT]
reclaim_age = 604800
bind_ip = 0.0.0.0

# Managed by swift-deploy-rs
# Parsed by swift-object-server ([app:object-server]) and by the
# swift-object-replicator / swift-object-updater / swift-object-reconstructor
# daemons (their own sections below; they read devices/bind_port from
# [app:object-server]).

[app:object-server]
bind_ip = 0.0.0.0
bind_port = 6210
servers_per_port = 1
devices = /srv/node
mount_check = false
workers = 0
# statsd -> local statsd_exporter (bundle-monitoring). Each daemon prefixes
# metrics with its log_name (object-server / object-replicator / ...); a
# non-empty log_statsd_metric_prefix would be PREPENDED to that, so it stays
# empty to keep the spec shapes (object-server.<METHOD>.<status>).
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-replicator]
reclaim_age = 604800
interval = 30

rsync_ssh_opts = ssh -i /etc/swift/replication_key -o StrictHostKeyChecking=accept-new
rsync_devices_root = /srv/node

log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-updater]
interval = 300
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-reconstructor]
interval = 30
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-expirer]
interval = 300
reclaim_age = 604800
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-auditor]
interval = 30
devices = /srv/node
mount_check = false
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =
