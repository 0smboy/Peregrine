    {
      "id": 11,
      "source": "roles/rust_haproxy/tasks/main.yml#6",
      "role": "rust_haproxy",
      "name": "generate self-signed HAProxy TLS material on first LB host",
      "host_pattern": "haproxy_servers",
      "hosts": [],
      "module": "shell",
      "args": "set -euo pipefail\nPEM=\"{{ haproxy_tls_pem | default('/etc/haproxy/haproxyCA.pem') }}\"\nCRT=/etc/haproxy/haproxy.crt\nKEY=/etc/haproxy/haproxy.key\nDAYS=\"{{ haproxy_tls_days | default(825) }}\"\nCN=\"{{ auth_url_ip }}\"\nif [ -f \"$PEM\" ] && [ -s \"$PEM\" ]; then\n  echo TLS-PRESENT\n  exit 0\nfi\nopenssl req -new -x509 -nodes -days \"$DAYS\" -subj \"/CN=$CN\" -out \"$CRT\" -keyout \"$KEY\"\ncat \"$CRT\" \"$KEY\" > \"$PEM\"\nchmod 600 \"$PEM\" \"$KEY\"\nchmod 644 \"$CRT\"\necho TLS-GENERATED\n",
      "vars": {},
      "when": [
        "use_lb and (identity_haproxy_enabled | default(false))",
        "lb_mode == \"https\" and (haproxy_tls_pem_src | default('')) | length == 0 and (haproxy_tls_self_signed | default(true)) and inventory_hostname == groups['haproxy_servers'][0]\n"
      ],
      "loops": [],
      "run_once": false,
      "become": false,
      "become_user": null,
      "delegate_to": null,
      "register": "rust_haproxy_tls_gen",
      "notify": [],
      "ignore_errors": false,
      "failed_when": [],
      "changed_when": [
        "rust_haproxy_tls_gen.stdout.find('TLS-GENERATED') != -1"
      ],
      "risk": []
    },
