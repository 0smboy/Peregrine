      "module": "shell",
      "args": "set -e\nresp=$(curl -sf -m 10 -D - -o /dev/null http://127.0.0.1:{{ proxy_bind_port }}/auth/v1.0 \\\n  -H 'X-Auth-User: {{ swift_tempauth_users[0].account }}:{{ swift_tempauth_users[0].user }}' \\\n  -H 'X-Auth-Key: {{ swift_tempauth_users[0].key }}')\ntoken=$(printf '%s' \"$resp\" | tr -d '\\r' | awk 'tolower($1)==\"x-auth-token:\" {print $2}')\nurl=$(printf '%s' \"$resp\" | tr -d '\\r' | awk 'tolower($1)==\"x-storage-url:\" {print $2}')\ntest -n \"$token\"\ntest -n \"$url\"\ncurl -sf -m 10 -X PUT \"$url/swift-deploy-verify\" -H \"X-Auth-Token: $token\" -o /dev/null\ncurl -sf -m 10 \"$url?format=plain\" -H \"X-Auth-Token: $token\" | grep -q '^swift-deploy-verify$'\necho ROUND-TRIP-OK\n",
      "vars": {},
      "when": [],
