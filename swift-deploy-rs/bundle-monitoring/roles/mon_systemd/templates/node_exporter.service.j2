# {{ ansible_managed }}
[Unit]
Description=Prometheus node exporter (swift monitoring)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitor
Group=monitor
ExecStart=/usr/local/bin/node_exporter --web.listen-address={{ storage_network_address }}:{{ node_exporter_port | default(9100) }}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
