# swift-deploy-rs rust-stack sample topology — a STRUCTURE EXAMPLE, never
# deployable: applies from a config_sample path are permanently refused.
#
# Two nodes:
#   10.0.0.11  proxy + account + container + object (three custom disks)
#   10.0.0.12  proxy + account + container + object (directory device d1)
#
# inventory_hostname is the management IP; ansible_user must be root.
10.0.0.11 ansible_user=root ansible_port=22 ansible_ssh_private_key_file=/path/to/id_ed25519
10.0.0.12 ansible_user=root ansible_port=22 ansible_ssh_private_key_file=/path/to/id_ed25519

