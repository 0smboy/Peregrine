# {{ ansible_managed }}
# Parsed by swift-object-server ([app:object-server]) and by the
# swift-object-replicator / swift-object-updater / swift-object-expirer /
# swift-object-auditor / swift-object-reconstructor daemons (their own
# sections below; they read devices/bind_port from [app:object-server]).

[app:object-server]
bind_ip = 0.0.0.0
bind_port = {{ object_bind_port }}
devices = {{ srv_node_root }}
mount_check = {{ 'true' if custom_disks | length > 0 else 'false' }}
workers = {{ object_workers }}
# Rust: workers*max_clients → worker_threads (cap 128) when servers_per_port=0.
# Wave 2: servers_per_port>0 → discover local object-ring ports; parent
# supervises one OS child per (port, worker_index) — process-isolated like
# Python. Rings use object_port_per_device (d1→6200, d2→6201, …). Contabo
# live rebuild is backlog until Wave 0 frees space (no wipe).
# See docs/fairness-lab/WORKERS-SEMANTICS.md / swift-effective-concurrency.
servers_per_port = {{ object_servers_per_port | default(0) }}
# ring_ip = {{ hostvars[inventory_hostname].get('storage_ip', '') }}
# statsd -> local statsd_exporter (bundle-monitoring). Each daemon prefixes
# metrics with its log_name (object-server / object-replicator / ...); a
# non-empty log_statsd_metric_prefix would be PREPENDED to that, so it stays
# empty to keep the spec shapes (object-server.<METHOD>.<status>).
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-replicator]
interval = 30
{% if groups['object_servers'] | length > 1 %}
rsync_ssh_opts = ssh -i /etc/swift/replication_key -o StrictHostKeyChecking=accept-new
rsync_devices_root = {{ srv_node_root }}
{% else %}
peer_map = {{ object_bind_port }}:{{ srv_node_root }}
{% endif %}
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-updater]
interval = 300
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-expirer]
interval = 300
reclaim_age = 604800
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

# Continuous auditor (P2b): Python ObjectAuditor interval default 30s.
[object-auditor]
interval = 30
devices = {{ srv_node_root }}
mount_check = {{ 'true' if custom_disks | length > 0 else 'false' }}
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[object-reconstructor]
interval = 30
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =
