# {{ ansible_managed }}
# Parsed by swift-account-server ([app:account-server]),
# swift-db-replicator account ([account-replicator]),
# swift-account-reaper ([account-reaper]), and
# swift-db-auditor account ([account-auditor]).

[app:account-server]
bind_ip = 0.0.0.0
bind_port = {{ account_bind_port }}
devices = {{ srv_node_root }}
mount_check = {{ 'true' if custom_disks | length > 0 else 'false' }}
# statsd -> local statsd_exporter (bundle-monitoring). Each daemon prefixes
# metrics with its log_name (account-server / account-replicator); a
# non-empty log_statsd_metric_prefix would be PREPENDED to that, so it stays
# empty to keep the spec shapes (account-server.<METHOD>.<status>).
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[account-replicator]
interval = 30
{% if groups['object_servers'] | length > 1 %}
rsync_ssh_opts = ssh -i /etc/swift/replication_key -o StrictHostKeyChecking=accept-new
rsync_devices_root = {{ srv_node_root }}
{% else %}
peer_map = {{ account_bind_port }}:{{ srv_node_root }}
{% endif %}
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

[account-reaper]
interval = 3600
delay_reaping = 0
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =

# Continuous account DB auditor (P2b): Python DatabaseAuditor interval default 1800s.
[account-auditor]
interval = 1800
devices = {{ srv_node_root }}
mount_check = {{ 'true' if custom_disks | length > 0 else 'false' }}
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =
