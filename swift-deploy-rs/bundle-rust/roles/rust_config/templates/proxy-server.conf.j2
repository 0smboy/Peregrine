# {{ ansible_managed }}
# Parsed by swift-proxy-server ([app:proxy-server] + filters).
# storage_url is what tempauth hands back as X-Storage-Url: the load
# balancer entry point when use_lb, otherwise this node's business address.
#
# P1b pipeline (P0+P1a + formpost/staticweb/quotas/symlink/versioned_writes).
# Smaller L2 (name_check/etag_quoter/crossdomain/domain_remap/cname_lookup/
# read_only) are ON-BY-CONFIG — insert into pipeline= and add filter sections.
# backend_ratelimit is a storage-node filter in Python; proxy wiring is
# available but not in the default pipeline.
# See docs/fairness-lab/PRODUCTION-GAP-ROADMAP.md.
#
# ratelimit: ON-BY-CONFIG (not in the default pipeline — changes perf
# baselines). To enable: insert `ratelimit` before `tempauth` in pipeline=
# and uncomment the [filter:ratelimit] sample below.
#
# Identity: auth_method=tempauth (default) | keystone | keystone_coexist
# keystone* require external Keystone (python bundle inventories/contabo-identity)
# plus identity_bridge HAProxy knobs — see docs/fairness-lab/KEYSTONE-LIVE.md
[pipeline:main]
{% if (auth_method | default('tempauth')) == 'keystone' %}
pipeline = catch_errors gatekeeper healthcheck proxy-logging cache listing_formats bulk tempurl formpost staticweb container_quotas account_quotas symlink versioned_writes authtoken keystoneauth copy slo dlo proxy-logging proxy-server
{% elif (auth_method | default('tempauth')) == 'keystone_coexist' %}
pipeline = catch_errors gatekeeper healthcheck proxy-logging cache listing_formats bulk tempurl formpost staticweb container_quotas account_quotas symlink versioned_writes authtoken keystoneauth tempauth copy slo dlo proxy-logging proxy-server
{% else %}
pipeline = catch_errors gatekeeper healthcheck proxy-logging cache listing_formats bulk tempurl formpost staticweb container_quotas account_quotas symlink versioned_writes tempauth copy slo dlo proxy-logging proxy-server
{% endif %}

[app:proxy-server]
bind_ip = 0.0.0.0
bind_port = {{ proxy_bind_port }}
account_autocreate = true
# Fail closed if a configured filter has no Rust implementation. A deliberate
# no-op requires both strict_pipeline=false and plugin_default=passthrough.
strict_pipeline = true
plugin_default = skip
{% if use_lb %}
storage_url = http://{{ auth_url_ip }}:{{ swift_lb_port }}
{% else %}
storage_url = http://{{ business_network_address }}:{{ proxy_bind_port }}
{% endif %}
# statsd -> local statsd_exporter (bundle-monitoring). The proxy uses
# log_statsd_metric_prefix VERBATIM and already embeds "proxy-server" in the
# metric names it emits, so the prefix stays empty; metrics arrive as
# proxy-server.<METHOD>.<status> / proxy-server.timing.
log_statsd_host = 127.0.0.1
log_statsd_port = 9125
log_statsd_metric_prefix =
# native OTLP/HTTP trace export: one span per client request. Empty
# endpoint disables tracing entirely (zero overhead).
trace_endpoint = {{ trace_endpoint | default('') }}
trace_sample_ratio = {{ trace_sample_ratio | default('1.0') }}

[filter:proxy-logging]
use = egg:swift#proxy_logging

[filter:cache]
use = egg:swift#memcache
# Per-node memcached (cluster cache). Override via inventory if needed.
memcache_servers = {{ memcache_servers | default(business_network_address ~ ':11211') }}

[filter:listing_formats]
use = egg:swift#listing_formats

[filter:bulk]
use = egg:swift#bulk
max_deletes_per_request = 10000
max_failed_deletes = 1000

[filter:tempurl]
use = egg:swift#tempurl
# methods / allowed_digests default to Swift's GET HEAD PUT POST DELETE and
# sha1/sha256/sha512 when omitted.

[filter:formpost]
use = egg:swift#formpost

[filter:staticweb]
use = egg:swift#staticweb

[filter:container_quotas]
use = egg:swift#container_quotas

[filter:account_quotas]
use = egg:swift#account_quotas

[filter:symlink]
use = egg:swift#symlink
symloop_max = 2

[filter:versioned_writes]
use = egg:swift#versioned_writes
allow_versioned_writes = true

{% if (auth_method | default('tempauth')) in ['tempauth', 'keystone_coexist'] %}
[filter:tempauth]
{% for entry in swift_tempauth_users %}
user_{{ entry.account }}_{{ entry.user }} = {{ entry.key }}{% if entry.get('admin', false) %} .admin{% endif %}

{% endfor %}
{% endif %}

