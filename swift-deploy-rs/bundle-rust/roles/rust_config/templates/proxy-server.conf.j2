# --- P3-auth Keystone path (ON-BY-CONFIG; Contabo lab stays TempAuth) ---
# External Keystone: python bundle/config_contabo_identity (see KEYSTONE-LIVE.md).
# Inlined (deploy-rs Renderer has no Jinja include loader). Default off.
# Triggers when identity_proxy_enabled OR auth_method in keystone|keystone_coexist.
{% set _auth = auth_method | default('tempauth') %}
{% if identity_proxy_enabled | default(false) or _auth in ['keystone', 'keystone_coexist'] %}
[filter:authtoken]
use = egg:swift#authtoken
delay_auth_decision = {{ identity_delay_auth_decision | default('true') }}
auth_url = {{ identity_auth_url | default('http://' ~ auth_url_ip ~ ':5000/v3') }}
username = {{ identity_swift_username | default('swift') }}
password = {{ identity_swift_password | default('CHANGE_ME') }}
project_name = {{ identity_swift_project | default('service') }}
user_domain_name = {{ identity_user_domain | default('Default') }}
project_domain_name = {{ identity_project_domain | default('Default') }}
www_authenticate_uri = {{ identity_www_authenticate_uri | default('http://' ~ auth_url_ip ~ ':5000') }}
http_connect_timeout = {{ identity_http_timeout | default('5') }}

[filter:keystoneauth]
use = egg:swift#keystoneauth
operator_roles = {{ identity_operator_roles | default('admin,swiftoperator') }}
reseller_prefix = {{ identity_reseller_prefix | default('AUTH') }}
reseller_admin_role = {{ identity_reseller_admin_role | default('ResellerAdmin') }}
allow_overrides = true
allow_names_in_acls = true
{% endif %}
# Manual / lab static map (when filters off):
# [filter:authtoken]
# use = egg:swift#authtoken
# delay_auth_decision = true
# auth_url = http://10.0.0.10:5000/v3
# username = swift
# password = CHANGE_ME
# project_name = service
# www_authenticate_uri = http://10.0.0.10:5000
# static_token_<tok> = <user_id> <user_name> <project_id> <project_name> [roles…]
# [filter:keystoneauth]
# use = egg:swift#keystoneauth
# operator_roles = admin,swiftoperator
# reseller_prefix = AUTH

# --- P3-s3 (ON-BY-CONFIG; NOT in default pipeline; NOT on Swift /info) ---
# Insert `s3api` immediately before `tempauth` in pipeline=, then uncomment:
# [filter:s3api]
# use = egg:swift#s3api
# location = us-east-1
# dns_compliant_bucket_names = true
# storage_domains =
# Access key = <account>:<user> from [filter:tempauth] user_* lines;
# secret = the TempAuth key. Minimal surface: SigV4 + bucket/object CRUD +
# ListBuckets/ListObjects v1 + GetBucketLocation. Residuals: MPU, ACL, v2 list.
