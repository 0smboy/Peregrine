# {{ ansible_managed }}
[Unit]
Description={{ svc_description }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SWIFT_DIR=/etc/swift
ExecStart=/usr/local/bin/{{ svc_bin }}{% if svc_args %} {{ svc_args }}{% endif %} /etc/swift/{{ svc_conf }}
Restart=on-failure
RestartSec=2
# Container-updater / reaper first sweeps can exceed the default 90s stop
# timeout while walking every DB; give them room to finish the current pass
# (SIGTERM is checked between passes) before systemd escalates to SIGKILL.
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
