# 此处填入所有主机的用户名、密码等信息
#
# 多台主机时如果参数相同,可以用[host_m:host_n] args的方式减少重复配置
# 如果参数不同,可以逐行列出
192.168.2.[51:52] ansible_user=root ansible_port=22 ansible_ssh_private_key_file=/path/to/id_ed25519

[ntp_server]
192.168.2.51

# 出现在ntp_clients中的主机不要出现在ntp_server中
[ntp_clients]
192.168.2.52

# 每个 proxy server 可以配置为不同的接口模式(http/https)
# ex: 192.168.2.51 proxy_mode=https
#     192.168.2.52 proxy_mode=http
[proxy_servers]
192.168.2.[51:52] proxy_mode=http

[account_servers]
192.168.2.[51:52]

[container_servers]
192.168.2.[51:52]

[object_servers]
192.168.2.[51:52]

[swift_nodes:children]
proxy_servers
account_servers
container_servers
object_servers

[storage_nodes:children]
account_servers
container_servers
object_servers

[mariadb_servers]
# 没有则为空
[keystones]

[format_disk_servers]
192.168.2.[51:52]


# 没有则为空
[haproxy_servers]


# keepalived_interface: 将虚拟IP绑在哪一块网卡上(网卡设备名)
# keepalived_priority: 权重优先级,值的范围0-255,主节点需要比被节点的值大
#
# 参考配置如下
#
# 请注意配置足够数量的keepalived servers和haproxy servers
# 用以保证任意两个节点宕机不会导致服务不可用
#
# 192.168.2.16 keepalived_interface=eno16777984 keepalived_priority=92
# 192.168.2.17 keepalived_interface=eno16777984 keepalived_priority=94
# 192.168.2.18 keepalived_interface=eno16777984 keepalived_priority=96
# 192.168.2.19 keepalived_interface=eno16777984 keepalived_priority=98
# 没有则为空
[keepalived_servers]

# 需要安装 proxyfs 文件系统的节点
# 目前只支持单节点安装
[proxyfs]

# 需要进行系统性能优化的节点
[performance_tuning]

# 没有则为空
[add_new_disk_servers]

