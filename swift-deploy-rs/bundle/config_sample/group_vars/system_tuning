# file_path 配置要修改的文件路径
# name 要操作配置文件的section 的名称
# add ：
# 向指定配置文件的特定section添加参数
# 若有需要添加的(key,value)时，需配置如下
#
#  add:
#       workers: 16
#       max_clients: 1024
#
# 若不需要添加(key,value)时，注释掉，配置如下
#
#   # add:
#       # workers: 16
#       # max_clients: 1024
#
# delete :
# 将指定配置文件的特定section移除参数
# 若有需要移除的(key,value)时，和添加参数(add)配置相似
# 若不需要操作任何时，需注释掉，同不添加参数配置
#
system_tuning_files:
  - file_path: /etc/swift/proxy-server.conf
    sections:
       - name: DEFAULT
         add:
            workers: 16
            max_clients: 1024
        # delete:
       - name: app:proxy-server
         add:
            concurrency_timeout: 0.5
        # delete:
  - file_path: /etc/swift/account-server.conf
    sections:
       - name: DEFAULT
         add:
            workers: 8
            max_clients: 1024
       - name: account-replicator
         add:
            concurrency: 8
        # delete:
  - file_path: /etc/swift/container-server.conf
    sections:
       - name: DEFAULT
         add:
            workers: 8
            max_clients: 1024
       - name: container-replicator
         add:
            concurrency: 8
        # delete:
  - file_path: /etc/swift/object-server.conf
    sections:
       - name: DEFAULT
         add:
            workers: 8
            max_clients: 1024
       - name: app:object-server
         add:
            replication_concurrency: 4
       - name: object-replicator
         add:
            concurrency: 1
       - name: object-updater
         add:
            concurrency: 1
       - name: object-auditor
         add:
            concurrency: 1
        # delete:
  - file_path: /etc/sysctl.conf
    sections:
       - name: no_ini_type_conf
         add:
            net.ipv4.tcp_syncookies: 0
            net.ipv4.tcp_tw_reuse: 1
            net.ipv4.tcp_tw_recycle: 1
            net.ipv4.tcp_fin_timeout: 30
            net.ipv4.ip_forward: 1
            vm.swappiness: 0
            net.ipv4.neigh.default.gc_stale_time: 120
            net.ipv4.conf.all.rp_filter: 0
            net.ipv4.conf.default.rp_filter: 0
            net.ipv4.conf.default.arp_announce: 2
            net.ipv4.conf.all.arp_announce: 2
            net.ipv4.tcp_max_syn_backlog: 1024
            net.ipv4.tcp_max_tw_buckets: 5000
            net.ipv4.netfilter.ip_conntrack_max: 262144
            fs.file-max: 65535
        # delete:

