# -A INPUT -p udp -m udp --match multiport --dports 137,138 -s 8.8.8.8,223.5.5.5 -j ACCEPT
# -A INPUT -p tcp -m tcp --match multiport --dports 139,445 --src-range 192.168.1.1-192.168.1.5 -j ACCEPT
# -A INPUT -p tcp -m tcp --match multiport --dports 139,445 -s 8.8.8.8,223.5.5.5 -j ACCEPT

# NFS: only allow nfs clients
# -A INPUT -p udp -m udp --match multiport --dports 111,2049 --src-range 192.168.1.1-192.168.1.5 -j ACCEPT
# -A INPUT -p udp -m udp --match multiport --dports 111,2049 -s 8.8.8.8,223.5.5.5 -j ACCEPT
# -A INPUT -p tcp -m tcp --match multiport --dports 111,2049,12345 --src-range 192.168.1.1-192.168.1.5 -j ACCEPT
# -A INPUT -p tcp -m tcp --match multiport --dports 111,2049,12345 -s 8.8.8.8,223.5.5.5 -j ACCEPT


-A FORWARD -j DROP
-A INPUT -j DROP
-A OUTPUT -j ACCEPT
COMMIT