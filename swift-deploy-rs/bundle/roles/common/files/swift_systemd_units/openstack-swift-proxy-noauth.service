[Unit]
Description=OpenStack Object Storage (swift) - Proxy Server No Auth
Wants=network-online.target
After=syslog.target network-online.target

[Service]
Type=simple
User=swift
ExecStart=/usr/bin/swift-proxy-server /etc/swift/proxy-server-noauth.conf
ExecReload=/bin/kill -SIGUSR1 $MAINPID

[Install]
WantedBy=multi-user.target